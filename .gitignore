############################
# Terraform
############################
**/.terraform/**
**/.terraform.lock.hcl

# State files (NUNCA versionar)
**/*.tfstate
**/*.tfstate.*
**/terraform.tfstate
**/terraform.tfstate.backup

# Overrides locais
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# tfvars (podem conter project_id, region, etc.)
*.tfvars
*.tfvars.json

# Terraform CLI config
.terraformrc
terraform.rc

############################
# Dados locais / temporários
############################
data/local/**

############################
# Python
############################
__pycache__/
*.pyc
*.pyo
*.pyd

.venv/
venv/
env/

############################
# Airflow
############################
airflow.db
logs/
dags/__pycache__/

############################
# Spark / Data Engineering
############################
*.parquet
*.avro
*.orc

############################
# GCP / Secrets / Credenciais
############################
.env
*.key
*.pem

# Service Accounts / Credenciais (JSON sensível)
*service-account*.json
*credentials*.json
*sa*.json

############################
# JSON PÚBLICO (permitido)
############################
# ⚠️ NÃO ignorar JSON globalmente
# Se existir JSON público (schema/config), ele deve ser versionado
!schemas/**/*.json
!config/**/*.json

############################
# OS / Editor
############################
.DS_Store
.vscode/
.idea/
