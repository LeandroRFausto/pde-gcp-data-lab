############################
# Terraform
############################

# Cache local do Terraform (NUNCA versionar)
.terraform/
**/.terraform/

# State files (NUNCA versionar)
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Plan files (artefato local)
tfplan
tfplan.*
*.tfplan

# Overrides locais
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# tfvars (podem conter project_id, region, etc.)
*.tfvars
*.tfvars.json

# Terraform CLI config
.terraformrc
terraform.rc

############################
# Backups / rascunhos antigos
############################

# Backup antigo de Terraform (fora do escopo do portfólio)
terraform/

############################
# Dados locais / temporários
############################

data/local/**

############################
# Python
############################

__pycache__/
*.pyc
*.pyo
*.pyd

# Ambientes virtuais (NUNCA versionar)
.venv/
venv/
env/

############################
# Airflow
############################

airflow.db
logs/
dags/__pycache__/

############################
# Spark / Data Engineering
############################

*.parquet
*.avro
*.orc

############################
# GCP / Secrets / Credenciais
############################

.env
*.key
*.pem

# Service Accounts / Credenciais (JSON sensível)
*service-account*.json
*credentials*.json
*sa*.json

############################
# JSON público NÃO versionado neste projeto
############################

